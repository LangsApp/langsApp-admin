<Window x:Class="LangApp.Admin.WPF.Views.Windows.EditStageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit stage"
        Width="620"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>

        <Style x:Key="InputStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CurrentValueStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#8B7CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Edit stage"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="Change the selected stage name and order"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#64748B"/>

        </StackPanel>

        <!-- Current values -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Current stage name"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <Border Height="40"
                        Padding="10,0"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="2">

                    <TextBlock Text="{Binding StageToEdit.Name}"
                               Style="{StaticResource CurrentValueStyle}"/>

                </Border>

            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="Current order"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <Border Height="40"
                        Padding="10,0"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="2">

                    <TextBlock Text="{Binding StageToEdit.Order}"
                               Style="{StaticResource CurrentValueStyle}"/>

                </Border>

            </StackPanel>

        </Grid>

        <!-- New values -->

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="New stage name"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <TextBox Style="{StaticResource InputStyle}"
                         Text="{Binding NewName,
                                        UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="New order"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <TextBox Style="{StaticResource InputStyle}"
                         Text="{Binding NewOrder,
                                        UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

        </Grid>

        <!-- Error -->

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Margin="0,8,0,0"
                   Foreground="#DC2626"
                   TextWrapping="Wrap"/>

        <!-- Actions -->

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CloseEditStageWindowCommand}"/>

            <Button Content="Save"
                    Width="120"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveEditedStageCommand}"/>

        </StackPanel>

    </Grid>

</Window>