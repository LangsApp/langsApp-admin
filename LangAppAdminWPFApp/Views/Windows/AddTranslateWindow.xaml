<Window x:Class="LangApp.Admin.WPF.Views.Windows.AddTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add translation"
        Height="440"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>

        <Style x:Key="InputStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SearchComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="220"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#8B7CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Add translation"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="Select a base word, target language and enter the translation"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#64748B"/>

        </StackPanel>

        <!-- Word and language -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Base word -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="Base word"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <ComboBox ItemsSource="{Binding BaseWords}"
                          SelectedItem="{Binding SelectedBaseWord}"
                          TextSearch.TextPath="DisplayWord"
                          Style="{StaticResource SearchComboBoxStyle}"
                          ToolTip="Start typing to search for a word">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding DisplayWord}"/>

                                <TextBlock Text="{Binding NormalizedWord}"
                                           Margin="8,0,0,0"
                                           Foreground="#94A3B8"/>

                            </StackPanel>

                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

            <!-- Target language -->

            <StackPanel Grid.Column="2">

                <TextBlock Text="Target language"
                           Margin="0,0,0,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          TextSearch.TextPath="Name"
                          Style="{StaticResource SearchComboBoxStyle}"
                          ToolTip="Start typing to search for a language">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding Name}"/>

                                <TextBlock Margin="8,0,0,0"
                                           Foreground="#94A3B8">

                                    <Run Text="("/>
                                    <Run Text="{Binding LangCode}"/>
                                    <Run Text=")"/>

                                </TextBlock>

                            </StackPanel>

                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

        </Grid>

        <!-- Translation -->

        <StackPanel Grid.Row="4">

            <TextBlock Text="Translation"
                       Margin="0,0,0,8"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <TextBox Style="{StaticResource InputStyle}"
                     Text="{Binding TranslationText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

        </StackPanel>

        <!-- Error -->

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Margin="0,8,0,0"
                   Foreground="#DC2626"
                   TextWrapping="Wrap"/>

        <!-- Actions -->

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CloseAddTranslationWindowCommand}"/>

            <Button Content="Add translation"
                    Width="150"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddTranslationCommand}"/>

        </StackPanel>

    </Grid>
</Window>