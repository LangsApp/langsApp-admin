<Window x:Class="LangApp.Admin.WPF.Views.Windows.AddWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add base words"
        Width="560"
        Height="470"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8FAFC">

    <Window.Resources>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#8B7CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Add base words"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="Add words to the list before saving"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#64748B"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Category (optional)"
                       Margin="0,0,0,8"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <TextBox Style="{StaticResource InputStyle}"
                     Text="{Binding Category,
                                    UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="New word"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource InputStyle}"
                         Text="{Binding NewWordText,
                                        UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2"/>

                <Button Grid.Column="3"
                        Content="+ Add"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddWordsToListCommand}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Words to add"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding NewWordsToSave}"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     Background="White"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding}"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#334155"/>

                            <Button Grid.Column="1"
                                    Content="Remove"
                                    Padding="8,4"
                                    Foreground="#DC2626"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.RemoveWordCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="7"
                   Text="{Binding ErrorMessage}"
                   Margin="0,10,0,0"
                   Foreground="#DC2626"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CloseAddWordWindowCommand}"/>

            <Button Content="Save words"
                    Width="130"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveWordsCommand}"/>
        </StackPanel>
    </Grid>
</Window>